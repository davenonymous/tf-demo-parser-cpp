  "type": "object",
  "properties": {
    "poses_spliced": {
      "type": "integer",
      "minimum": 0
    },
    "poses_skipped": {
      "type": "integer",
      "minimum": 0
    },
    "poses_unplaceable": {
      "type": "integer",
      "minimum": 0
    },
    "handbacks": {
      "type": "integer",
      "minimum": 0
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "poses_spliced",
    "poses_skipped",
    "poses_unplaceable",
    "handbacks",
    "bytes"
  ],
  "additionalProperties": false
