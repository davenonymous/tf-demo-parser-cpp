{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tfdemo stringtables",
  "description": "One JSON array: the string tables at the end of the demo.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 0
      },
      "name": {
        "type": "string"
      },
      "max_entries": {
        "type": "integer",
        "minimum": 0
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "user_data_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "name",
      "max_entries",
      "entries"
    ],
    "additionalProperties": false
  }
}
