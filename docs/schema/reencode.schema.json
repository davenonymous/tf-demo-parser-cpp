{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tfdemo reencode",
  "description": "One JSON object: the sizes of the demo read and the demo written, and whether they are the same bytes.",
  "type": "object",
  "properties": {
    "input_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "identical": {
      "type": "boolean"
    }
  },
  "required": [
    "input_bytes",
    "output_bytes",
    "identical"
  ],
  "additionalProperties": false
}
